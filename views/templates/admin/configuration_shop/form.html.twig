{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="card rj-configuration-shop-card">
        <h3 class="card-header d-flex align-items-center gap-2">
          <i class="material-icons">store</i>
          <span>{{ action == 'create' ? 'Nuevo remitente'|trans({}, 'Modules.RjMulticarrier.Admin') : 'Editar remitente'|trans({}, 'Modules.RjMulticarrier.Admin') }}</span>
        </h3>
        <div class="card-body">
          {{ form_errors(form) }}

          <div class="row">
            <div class="col-md-6">{{ form_row(form.firstname) }}</div>
            <div class="col-md-6">{{ form_row(form.lastname) }}</div>
          </div>
          <div class="row">
            <div class="col-md-6">{{ form_row(form.company) }}</div>
            <div class="col-md-6">{{ form_row(form.additionalname) }}</div>
          </div>
          <div class="row">
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-6">{{ form_row(form.phone) }}</div>
          </div>
          <div class="row">
            <div class="col-md-6">{{ form_row(form.vatnumber) }}</div>
            <div class="col-md-6">{{ form_row(form.isbusiness) }}</div>
          </div>

          <hr />

          <div class="row">
            <div class="col-md-6">{{ form_row(form.street) }}</div>
            <div class="col-md-3">{{ form_row(form.number) }}</div>
            <div class="col-md-3">{{ form_row(form.postcode) }}</div>
          </div>
          <div class="row">
            <div class="col-md-6">{{ form_row(form.city) }}</div>
            <div class="col-md-6">{{ form_row(form.state) }}</div>
          </div>
          {{ form_row(form.id_country) }}
          {{ form_row(form.additionaladdress) }}

          {% if form.shop_association is defined %}
            <hr />
            {{ form_row(form.shop_association) }}
          {% endif %}

          <hr />
          <div class="row">
            <div class="col-md-6">{{ form_row(form.RJ_ETIQUETA_TRANSP_PREFIX) }}</div>
            <div class="col-md-6">{{ form_row(form.RJ_MODULE_CONTRAREEMBOLSO) }}</div>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-between align-items-center">
            <a class="btn btn-secondary" href="{{ path('admin_rj_multicarrier_configuration_shop_index') }}">
              {{ 'Cancelar'|trans({}, 'Admin.Actions') }}
            </a>
            <button type="submit" class="btn btn-primary">
              {{ 'Guardar'|trans({}, 'Admin.Actions') }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{ form_rest(form) }}
  {{ form_end(form, { render_rest: false }) }}
{% endblock %}
