{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    {% if adapterInstallCards is defined and adapterInstallCards|length > 0 %}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <h3 class="card-header-title mb-1">{{ 'Conectores disponibles'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h3>
                            <p class="mb-0 text-muted small">{{ 'Instala cada carrier como si fuese un módulo independiente y aplica sus valores por defecto automáticamente.'|trans({}, 'Modules.RjMulticarrier.Admin') }}</p>
                        </div>
                        <span class="badge badge-primary mt-2 mt-md-0">{{ adapterInstallCards|length }} {{ 'disponibles'|trans({}, 'Modules.RjMulticarrier.Admin') }}</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            {% for card in adapterInstallCards %}
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="h-100 border rounded p-3 d-flex flex-column">
                                        <div class="d-flex align-items-center mb-3">
                                            <span class="badge badge-pill badge-info text-uppercase mr-3 px-3 py-2">{{ card.code }}</span>
                                            <div>
                                                <strong>{{ card.name }}</strong>
                                                <div class="text-muted small">{{ 'Instalador rápido'|trans({}, 'Modules.RjMulticarrier.Admin') }}</div>
                                            </div>
                                        </div>
                                        <p class="text-muted mb-3">{{ card.description }}</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge badge-{{ card.supportsApi ? 'success' : 'secondary' }}">
                                                {{ card.supportsApi ? 'Soporta API'|trans({}, 'Modules.RjMulticarrier.Admin') : 'Configuración manual'|trans({}, 'Modules.RjMulticarrier.Admin') }}
                                            </span>
                                            <form method="post" action="{{ path('admin_rj_multicarrier_carriers_install_adapter') }}" class="mb-0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('rj_multicarrier_carrier_install') }}">
                                                <input type="hidden" name="adapter_code" value="{{ card.code }}">
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    {{ 'Instalar'|trans({}, 'Modules.RjMulticarrier.Admin') }}
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-12">
            {% embed '@PrestaShop/Admin/Common/Grid/grid_panel.html.twig' with { grid: carrierGrid } %}
                {% block grid_panel_header %}
                    <div class="card-header js-grid-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <h3 class="card-header-title mb-0">{{ 'Carriers'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h3>
                            <span class="badge badge-secondary ml-2">{{ grid.data.records_total }}</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <a
                                href="{{ path('admin_rj_multicarrier_carriers_create') }}"
                                class="btn btn-outline-primary btn-sm mr-2"
                            >
                                {{ 'Create carrier'|trans({}, 'Modules.RjMulticarrier.Admin') }}
                            </a>
                            {{ include('@PrestaShop/Admin/Common/Grid/Blocks/grid_actions.html.twig', { grid: grid }) }}
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    <div
        class="modal fade js-detail-modal"
        id="rj_carrier_detail_modal"
        tabindex="-1"
        role="dialog"
        aria-hidden="true"
        data-empty="{{ 'No disponible'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
        data-error-generic="{{ 'No se pudo cargar el detalle del transportista.'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
        data-error-not-found="{{ 'El transportista solicitado ya no existe.'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
        data-trigger=".js-carrier-view-row-action"
    >
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mb-0">{{ 'Carrier details'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none js-detail-error" role="alert"></div>

                    <div class="text-center my-4 d-none js-detail-spinner">
                        <span class="spinner-border" role="status" aria-hidden="true"></span>
                        <span class="sr-only">{{ 'Cargando…'|trans({}, 'Admin.Actions') }}</span>
                    </div>

                    <div class="js-detail-content d-none">
                        <dl class="row">
                            <dt class="col-sm-4">{{ 'ID'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="id">—</dd>

                            <dt class="col-sm-4">{{ 'Name'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="name">—</dd>

                            <dt class="col-sm-4">{{ 'Short name'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="shortName">—</dd>

                            <dt class="col-sm-4">{{ 'Activo'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="isActive" data-detail-render="boolean" data-detail-true="{{ 'Sí'|trans({}, 'Admin.Global') }}" data-detail-false="{{ 'No'|trans({}, 'Admin.Global') }}">—</dd>

                            <dt class="col-sm-4">{{ 'Soporta API'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="supportsApi" data-detail-render="boolean" data-detail-true="{{ 'Sí'|trans({}, 'Admin.Global') }}" data-detail-false="{{ 'No'|trans({}, 'Admin.Global') }}">—</dd>

                            <dt class="col-sm-4">{{ 'Adapter service'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="adapterService">—</dd>

                            <dt class="col-sm-4">{{ 'Created at'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="createdAt">—</dd>

                            <dt class="col-sm-4">{{ 'Updated at'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
                            <dd class="col-sm-8 js-detail-field" data-detail-field="updatedAt">—</dd>
                        </dl>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">{{ 'Close'|trans({}, 'Admin.Actions') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
