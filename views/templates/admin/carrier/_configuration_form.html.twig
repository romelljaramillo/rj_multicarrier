{% set configurationFormAction = configurationFormAction|default('') %}
{% set configurationCsrfToken = configurationCsrfToken|default('') %}
{% set redirectAfterSubmit = redirectAfterSubmit|default(null) %}
{% set backUrl = backUrl|default(path('admin_rj_multicarrier_carriers_index')) %}
{% set defaultConfigurations = defaultConfigurations|default([]) %}
{% set extraConfigurations = extraConfigurations|default([]) %}

<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <h3 class="card-title mb-0">{{ 'Configuración del transportista'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h3>
    <a class="btn btn-outline-secondary btn-sm" href="{{ backUrl }}">
      {{ 'Volver al listado'|trans({}, 'Modules.RjMulticarrier.Admin') }}
    </a>
  </div>
  <div class="card-body">
    <p class="text-muted mb-4">
      {{ 'Las configuraciones por defecto permanecen fijas y se completan automáticamente al crear nuevos carriers. Puedes añadir valores adicionales según tus necesidades.'|trans({}, 'Modules.RjMulticarrier.Admin') }}
    </p>

    <form method="post" id="carrier-configurations-form" action="{{ configurationFormAction }}">
      <input type="hidden" name="_token" value="{{ configurationCsrfToken }}">
      {% if redirectAfterSubmit %}
        <input type="hidden" name="redirect_to" value="{{ redirectAfterSubmit }}">
      {% endif %}

      <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h4 class="mb-1">{{ 'Configuraciones por defecto'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h4>
            <p class="text-muted mb-0">{{ 'Estos campos son obligatorios y no se pueden eliminar.'|trans({}, 'Modules.RjMulticarrier.Admin') }}</p>
          </div>
        </div>

        {% if defaultConfigurations is not empty %}
          <div class="row">
            {% for configuration in defaultConfigurations %}
              <div class="col-lg-6 col-xl-6">
                <div class="mb-4">
                  <input type="hidden" name="defaults[{{ loop.index0 }}][id]" value="{{ configuration.id }}">
                  <input type="hidden" name="defaults[{{ loop.index0 }}][name]" value="{{ configuration.name }}">

                  <label class="form-label fw-bold d-flex align-items-center justify-content-between" for="input-def-{{ configuration.id }}">
                      <span>{{ configuration.label ?? configuration.displayName }}</span>
                      <code class="small text-muted fw-normal">{{ configuration.name }}</code>
                  </label>

                  {% if configuration.fieldType == 'boolean' %}
                    <div class="form-check form-switch ps-0">
                        <input type="hidden" name="defaults[{{ loop.index0 }}][value]" value="0">
                        <input 
                            class="form-check-input ms-0" 
                            type="checkbox" 
                            role="switch"
                            name="defaults[{{ loop.index0 }}][value]" 
                            value="1" 
                            id="input-def-{{ configuration.id }}" 
                            {% if configuration.value == '1' %}checked{% endif %}
                        >
                        <label class="form-check-label ps-2" for="input-def-{{ configuration.id }}">
                            {{ configuration.value == '1' ? 'Activado'|trans({}, 'Admin.Global') : 'Desactivado'|trans({}, 'Admin.Global') }}
                        </label>
                    </div>
                  {% elseif configuration.fieldType == 'password' %}
                     <div class="input-group">
                        <input 
                            type="password" 
                            class="form-control" 
                            id="input-def-{{ configuration.id }}"
                            name="defaults[{{ loop.index0 }}][value]" 
                            value="{{ configuration.value ?? '' }}"
                            placeholder="••••••••"
                        >
                        <button class="btn btn-outline-secondary" type="button" tabindex="-1" onclick="const i=this.previousElementSibling;i.type=i.type==='password'?'text':'password'">
                            <i class="material-icons">visibility</i>
                        </button>
                    </div>
                  {% elseif configuration.fieldType == 'number' %}
                     <input 
                        type="number" 
                        step="any" 
                        class="form-control" 
                        id="input-def-{{ configuration.id }}"
                        name="defaults[{{ loop.index0 }}][value]" 
                        value="{{ configuration.value ?? '' }}"
                     >
                  {% else %}
                    <input 
                        type="text" 
                        class="form-control" 
                        id="input-def-{{ configuration.id }}"
                        name="defaults[{{ loop.index0 }}][value]" 
                        value="{{ configuration.value ?? '' }}"
                    >
                  {% endif %}

                  {% if configuration.description %}
                    <div class="form-text text-muted mt-1 small">
                        {{ configuration.description }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-muted mb-0">{{ 'Este transportista no define configuraciones por defecto.'|trans({}, 'Modules.RjMulticarrier.Admin') }}</p>
        {% endif %}
      </section>

      <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary" href="{{ backUrl }}">
          {{ 'Cancelar'|trans({}, 'Admin.Actions') }}
        </a>
        <button type="submit" class="btn btn-primary">
          {{ 'Guardar cambios'|trans({}, 'Modules.RjMulticarrier.Admin') }}
        </button>
      </div>
    </form>
  </div>
</div>
