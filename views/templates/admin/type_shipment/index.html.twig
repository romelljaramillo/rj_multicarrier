{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
{% set grid = typeShipmentGrid %}
<div class="row">
  <div class="col-12">
    <div class="card js-grid-panel" id="{{ grid.id }}_grid_panel">
      
        <div class="card-header js-grid-header">
          <div class="d-flex justify-content-between align-items-center w-100">
              <div class="d-flex align-items-center">
                <h3 class="card-header-title mb-0 d-inline-block">{{ 'Tipos de envío'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h3>
                <span class="badge bg-secondary ms-2">{{ grid.data.records_total }}</span>
              </div>
              <div class="d-flex align-items-center">
                {% if companies|length > 1 %}
                  <form method="get" action="{{ path('admin_rj_multicarrier_type_shipment_index') }}" class="mb-0 me-3">
                      <div class="input-group input-group-sm shadow-sm  me-2">
                          <div class="input-group-prepend">
                              <span class="input-group-text bg-white border-end-0">
                                  <i class="material-icons text-primary" style="font-size: 16px;">local_shipping</i>
                              </span>
                          </div>
                          <select id="type_shipment_company_filter" name="company" class="custom-select border-start-0 ps-0" style="min-width: 200px; outline: none; box-shadow: none; height: 31px;" onchange="RoanjaTypeShipment.changeCompany(this)">
                              {% for company in companies %}
                                <option value="{{ company.id }}" {% if company.selected %}selected{% endif %}>{{ company.name }}</option>
                              {% endfor %}
                          </select>
                      </div>
                  </form>
                {% endif %}
                <a
                  href="{{ path('admin_rj_multicarrier_type_shipment_create') }}"
                  class="btn btn-primary btn-sm mx-2"
                >
                  <i class="material-icons">add</i>
                  {{ 'Nuevo tipo de envío'|trans({}, 'Modules.RjMulticarrier.Admin') }}
                </a>
                {{ include('@PrestaShop/Admin/Common/Grid/Blocks/grid_actions.html.twig', { grid: grid }) }}
              </div>
          </div>
        </div>
      
        <div class="card-body">
          {% embed '@PrestaShop/Admin/Common/Grid/grid.html.twig' with { grid: grid, allReferenceCarriers: allReferenceCarriers, assignedReferenceCarriers: assignedReferenceCarriers } %}
            {% block grid_table_row %}
                {{ renderhook('displayAdminGridTableBefore', {
                    'grid': grid,
                    'legacy_controller': app.request.attributes.get('_legacy_controller'),
                    'controller': app.request.attributes.get('_controller')
                  })
                }}

                {{ form_start(grid.filter_form, {'attr': {'id': grid.id ~ '_filter_form', 'class': 'table-responsive'}}) }}

                <table class="grid-table js-grid-table table {% if is_ordering_column(grid) %}grid-ordering-column{% endif %} {% if grid.attributes.is_empty_state %}border-0{% endif %}"
                       id="{{ grid.id }}_grid_table"
                       data-query="{{ grid.data.query }}"
                       data-limit="{{ grid.pagination.limit }}"
                       data-offset="{{ grid.pagination.offset }}"
                       data-total="{{ grid.data.records_total }}"
                >
                  <thead class="thead-default">
                    {{ include('@PrestaShop/Admin/Common/Grid/Blocks/Table/headers_row.html.twig', {'grid': grid}) }}
                    {% if grid.actions.bulk|length > 0 or grid.filter_form|length > 1 %}
                      {{ include('@PrestaShop/Admin/Common/Grid/Blocks/Table/filters_row.html.twig', {'grid': grid}) }}
                    {% endif %}
                  </thead>
                  <tbody>
                    {% if grid.data.records is not empty %}
                      {% for record in grid.data.records %}
                        <tr>
                          {% for column in grid.columns %}
                            <td
                              {% if column.type == 'identifier' %}data-identifier="{{ record[column.id] }}"{% endif %}
                              class="{{ column.type }}-type column-{{ column.id }}{% if column.options.clickable is defined and column.options.clickable %} clickable{% endif %}{% if column.options.alignment is defined and column.options.alignment %} text-{{ column.options.alignment }}{% endif %}"
                            >
                              {% if column.id == 'reference_carrier_name' %}
                                  <select 
                                    class="custom-select custom-select-sm js-reference-carrier-select" 
                                    data-url="{{ path('admin_rj_multicarrier_type_shipment_update_reference_carrier', {'id': record.id_type_shipment}) }}"
                                    style="width: 100%; min-width: 150px;"
                                  >
                                    <option value="0">-- {{ 'Ninguno'|trans({}, 'Admin.Global') }} --</option>
                                    {% for carrier in allReferenceCarriers %}
                                        {# Show option if: 
                                           1. Carrier is not assigned to any type shipment
                                           2. OR Carrier is assigned to THIS type shipment (the one in the current record)
                                        #}
                                        {% set isAssigned = carrier.id_reference in assignedReferenceCarriers %}
                                        {% set isCurrent = (record.id_reference_carrier is defined and record.id_reference_carrier == carrier.id_reference) %}
                                        
                                        {% if not isAssigned or isCurrent %}
                                          <option value="{{ carrier.id_reference }}" {% if isCurrent %}selected{% endif %}>
                                            {{ carrier.name }}
                                          </option>
                                        {% endif %}
                                    {% endfor %}
                                  </select>
                              {% else %}
                                  {{ column_content(record, column, grid) }}
                              {% endif %}
                            </td>
                          {% endfor %}
                        </tr>
                      {% endfor %}
                    {% else %}
                      {{ include('@PrestaShop/Admin/Common/Grid/Blocks/Table/empty_row.html.twig', {'grid': grid}) }}
                    {% endif %}
                  </tbody>
                  <tfoot></tfoot>
                </table>

                {{ form_end(grid.filter_form) }}

                {{ renderhook('displayAdminGridTableAfter', {
                      'grid': grid,
                      'legacy_controller': app.request.attributes.get('_legacy_controller'),
                      'controller': app.request.attributes.get('_controller')
                    })
                }}
            {% endblock %}
          {% endembed %}
        </div>
      
    </div>
  </div>
</div>

  <div
    class="modal fade js-detail-modal"
    id="rj_type_shipment_detail_modal"
    tabindex="-1"
    role="dialog"
    aria-hidden="true"
    data-empty="{{ 'No disponible'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
    data-error-generic="{{ 'No se pudo cargar el detalle del tipo de envío.'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
    data-error-not-found="{{ 'El tipo de envío solicitado ya no existe.'|trans({}, 'Modules.RjMulticarrier.Admin') }}"
    data-trigger=".js-type-shipment-view-row-action"
  >
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
      <div class="modal-content shadow">
        <div class="modal-header">
          <h5 class="modal-title mb-0 h4">{{ 'Detalle del tipo de envío'|trans({}, 'Modules.RjMulticarrier.Admin') }}</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Cerrar'|trans({}, 'Admin.Actions') }}">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body p-4">
          <div class="alert alert-danger d-none js-detail-error" role="alert"></div>

          <div class="text-center my-4 d-none js-detail-spinner">
            <span class="spinner-border" role="status" aria-hidden="true"></span>
            <span class="sr-only">{{ 'Cargando…'|trans({}, 'Admin.Actions') }}</span>
          </div>

          <div class="js-detail-content d-none">
            <dl class="row">
              <dt class="col-sm-4">{{ 'ID'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="id">—</dd>

              <dt class="col-sm-4">{{ 'Compañía'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="companyName">—</dd>

              <dt class="col-sm-4">{{ 'Nombre corto'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="companyShortName">—</dd>

              <dt class="col-sm-4">{{ 'Nombre'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="name">—</dd>

              <dt class="col-sm-4">{{ 'Código comercial'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="businessCode">—</dd>

              <dt class="col-sm-4">{{ 'Carrier referencia'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="referenceCarrierId">—</dd>

              <dt class="col-sm-4">{{ 'Activo'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd
                class="col-sm-8 js-detail-field"
                data-detail-field="active"
                data-detail-render="boolean"
                data-detail-true="{{ 'Sí'|trans({}, 'Admin.Global') }}"
                data-detail-false="{{ 'No'|trans({}, 'Admin.Global') }}"
              >—</dd>

              <dt class="col-sm-4">{{ 'Creado el'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="createdAt">—</dd>

              <dt class="col-sm-4">{{ 'Actualizado el'|trans({}, 'Modules.RjMulticarrier.Admin') }}</dt>
              <dd class="col-sm-8 js-detail-field" data-detail-field="updatedAt">—</dd>
            </dl>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">{{ 'Cerrar'|trans({}, 'Admin.Actions') }}</button>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    window.RoanjaTypeShipment = window.RoanjaTypeShipment || {};
    (function (ns) {
      ns.changeCompany = function (select) {
        try {
          var company = encodeURIComponent(select.value || '');
          var url = new URL(window.location.href);
          url.searchParams.set('company', company);
          // Keep any existing token query parameter if present
          window.location.href = url.toString();
        } catch (e) {
          // Fallback: submit the nearest form
          var form = select && select.form;
          if (form) {
            form.submit();
          }
        }
      };

      ns.initGridListeners = function() {
          $(document).on('change', '.js-reference-carrier-select', function() {
            var $select = $(this);
            var url = $select.data('url');
            var value = $select.val();
            
            $select.addClass('disabled').prop('disabled', true);
            
            $.ajax({
                url: url,
                method: 'POST',
                data: { reference_carrier_id: value },
                success: function(response) {
                    $.growl.notice({ title: "Éxito", message: response.message });
                },
                error: function(xhr) {
                    var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Error desconocido';
                    $.growl.error({ title: "Error", message: msg });
                },
                complete: function() {
                    $select.removeClass('disabled').prop('disabled', false);
                }
            });
          });
      };
      
      $(function() {
        ns.initGridListeners();
      });
    })(window.RoanjaTypeShipment);
  </script>
{% endblock %}
