{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(form, {
    action: path(isEdit ? 'admin_rj_multicarrier_type_shipment_edit' : 'admin_rj_multicarrier_type_shipment_create', actionParams|default({})),
    attr: { novalidate: 'novalidate' }
  }) }}
  <div class="row justify-content-center">
    <div class="col-xl-8">
      <div class="card rj-type-shipment-card">
        <h3 class="card-header d-flex align-items-center gap-2">
          <i class="material-icons">local_shipping</i>
          <span>{{ isEdit ? 'Editar tipo de envío'|trans({}, 'Modules.RjMulticarrier.Admin') : 'Nuevo tipo de envío'|trans({}, 'Modules.RjMulticarrier.Admin') }}</span>
        </h3>
        <div class="card-body">
          {{ form_errors(form) }}

          <div class="form-group">
            {{ form_row(form.carrier_id) }}
          </div>

          <div class="form-group">
            {{ form_row(form.name) }}
          </div>

          <div class="form-group">
            {{ form_row(form.business_code) }}
          </div>

          <div class="form-group">
            {{ form_row(form.reference_carrier_id) }}
          </div>

          <div class="form-group">
            {{ form_row(form.active) }}
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_rj_multicarrier_type_shipment_index', returnParams|default({})) }}" class="btn btn-outline-secondary">
              {{ 'Cancelar'|trans({}, 'Admin.Actions') }}
            </a>
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{ form_rest(form) }}
  {{ form_end(form, { render_rest: false }) }}
{% endblock %}
