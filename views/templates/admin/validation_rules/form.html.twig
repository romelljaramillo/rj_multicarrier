{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(form, {
    action: path(
      isEdit ? 'admin_rj_multicarrier_validation_rule_edit' : 'admin_rj_multicarrier_validation_rule_create',
      isEdit ? {id: ruleId|default(form.vars.value.id)} : {}
    ),
    attr: { novalidate: 'novalidate' }
  }) }}
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="card rj-select2-scope rj-validation-rule-card">
        <h3 class="card-header d-flex align-items-center gap-2">
          <i class="material-icons">rule</i>
          <span>{{ isEdit ? 'Editar regla de validación'|trans({}, 'Modules.RjMulticarrier.Admin') : 'Nueva regla de validación'|trans({}, 'Modules.RjMulticarrier.Admin') }}</span>
        </h3>
        <div class="card-body">
        {{ form_errors(form) }}

        {% if currentShopName %}
          <div class="alert alert-info">
            {{ 'Esta regla se guardará exclusivamente para la tienda: %shop%'|trans({'%shop%': currentShopName}, 'Modules.RjMulticarrier.Admin') }}
          </div>
        {% else %}
          <div class="alert alert-warning">
            {{ 'Selecciona una tienda concreta en el selector multitienda antes de guardar.'|trans({}, 'Modules.RjMulticarrier.Admin') }}
          </div>
        {% endif %}

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              {{ form_row(form.name) }}
            </div>
            <div class="form-group">
              {{ form_row(form.priority) }}
            </div>
            <div class="form-group">
              {{ form_row(form.active) }}
            </div>
            <div class="form-row">
              <div class="form-group col-md-6">
                {{ form_row(form.min_weight) }}
              </div>
              <div class="form-group col-md-6">
                {{ form_row(form.max_weight) }}
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="rj-select2-field">
              {{ form_label(form.allow_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.allow_ids) }}
              </div>
              {{ form_errors(form.allow_ids) }}
              {{ form_help(form.allow_ids) }}
            </div>
            <div class="rj-select2-field">
              {{ form_label(form.deny_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.deny_ids) }}
              </div>
              {{ form_errors(form.deny_ids) }}
              {{ form_help(form.deny_ids) }}
            </div>
            <div class="rj-select2-field">
              {{ form_label(form.add_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.add_ids) }}
              </div>
              {{ form_errors(form.add_ids) }}
              {{ form_help(form.add_ids) }}
            </div>
          </div>
        </div>

        <hr class="my-4" />

        <div class="row rj-select2-grid g-4">
          <div class="col-md-6">
            <div class="rj-select2-field">
              {{ form_label(form.product_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.product_ids) }}
              </div>
              {{ form_errors(form.product_ids) }}
              {{ form_help(form.product_ids) }}
            </div>
            <div class="rj-select2-field">
              {{ form_label(form.category_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.category_ids) }}
              </div>
              {{ form_errors(form.category_ids) }}
              {{ form_help(form.category_ids) }}
            </div>
          </div>
          <div class="col-md-6">
            <div class="rj-select2-field">
              {{ form_label(form.zone_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.zone_ids) }}
              </div>
              {{ form_errors(form.zone_ids) }}
              {{ form_help(form.zone_ids) }}
            </div>
            <div class="rj-select2-field">
              {{ form_label(form.country_ids) }}
              <div class="rj-select2-field__control">
                {{ form_widget(form.country_ids) }}
              </div>
              {{ form_errors(form.country_ids) }}
              {{ form_help(form.country_ids) }}
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_rj_multicarrier_validation_rule_index') }}" class="btn btn-secondary">
              {{ 'Cancelar'|trans({}, 'Admin.Actions') }}
            </a>
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{ form_rest(form) }}
  {{ form_end(form, { render_rest: false }) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function () {
      var select2InitRequested = false;

      function addDropdownThemeClass() {
        if (typeof document === 'undefined') {
          return;
        }

        var dropdowns = document.querySelectorAll('.select2-container--open .select2-dropdown');
        dropdowns.forEach(function (dropdown) {
          dropdown.classList.add('rj-select2-theme-dropdown');
        });
      }

      function removeDropdownThemeClass() {
        if (typeof document === 'undefined') {
          return;
        }

        var dropdowns = document.querySelectorAll('.select2-dropdown.rj-select2-theme-dropdown');
        dropdowns.forEach(function (dropdown) {
          dropdown.classList.remove('rj-select2-theme-dropdown');
        });
      }

      function escapeHtml(value) {
        if (typeof value !== 'string') {
          return value === undefined || value === null ? '' : String(value);
        }

        var ENTITY_MAP = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };

        return value.replace(/[&<>"']/g, function (char) {
          return ENTITY_MAP[char] || char;
        });
      }

      function buildCarrierTemplate($element) {
        var optionCarrierMap = {};
        var serializedCarrierMap = null;

        if ($element && typeof $element.attr === 'function') {
          serializedCarrierMap = $element.attr('data-carrier-map') || null;
        }

        if ($element && typeof $element.find === 'function') {
          $element.find('option[data-carrier-id]').each(function () {
            var key = typeof this.value === 'string' ? this.value : String(this.value || '');
            if (!key) {
              return;
            }

            optionCarrierMap[key] = this.getAttribute('data-carrier-id');
          });
        }

        var serializedCarrierMapLookup = {};

        if (serializedCarrierMap) {
          try {
            var parsed = JSON.parse(serializedCarrierMap);

            if (parsed && typeof parsed === 'object') {
              Object.keys(parsed).forEach(function (key) {
                serializedCarrierMapLookup[String(key)] = parsed[key];
              });
            }
          } catch (error) {
            // ignore invalid payloads
          }
        }

        function resolveCarrierId(data) {
          if (!data) {
            return null;
          }

          if (data.element && typeof data.element.getAttribute === 'function') {
            var elementAttr = data.element.getAttribute('data-carrier-id');
            if (elementAttr) {
              return elementAttr;
            }
          }

          if (typeof data.id === 'undefined' || data.id === null) {
            return null;
          }

          var mapKey = String(data.id);

          if (Object.prototype.hasOwnProperty.call(optionCarrierMap, mapKey)) {
            return optionCarrierMap[mapKey];
          }

          if (Object.prototype.hasOwnProperty.call(serializedCarrierMapLookup, mapKey)) {
            return serializedCarrierMapLookup[mapKey];
          }

          return null;
        }

        function formatData(data) {
          if (!data) {
            return '';
          }

          var labelSource = '';

          if (typeof data.text === 'string' && data.text !== '') {
            labelSource = data.text;
          } else if (data.element && typeof data.element.textContent === 'string') {
            labelSource = data.element.textContent;
          } else if (data.id) {
            labelSource = data.id;
          }

          var label = escapeHtml(String(labelSource));
          var carrierId = resolveCarrierId(data);

          if (!carrierId) {
            return label;
          }

          var badge = '<span class="badge badge-primary rj-carrier-badge">ID ' + escapeHtml(String(carrierId)) + '</span>';

          return '<span class="rj-carrier-option"><span class="rj-carrier-option__label">' + label + '</span>' + badge + '</span>';
        }

        return {
          format: formatData,
          resolveCarrierId: resolveCarrierId,
        };
      }

      function updateCarrierSelections($element, formatter) {
        var $ = window.jQuery || window.$;

        if (typeof $ !== 'function' || !formatter || typeof formatter.format !== 'function' || !$element || typeof $element.data !== 'function') {
          return;
        }

        var instance = $element.data('select2');

        if (!instance || !instance.$selection) {
          return;
        }

        var $choices = instance.$selection.find('.select2-selection__choice');
        var $removeSelector = '.select2-selection__choice__remove';

        $choices.each(function () {
          var $choice = $(this);
          var $remove = $choice.children($removeSelector).first();
          var data = $choice.data('data');

          if (!data) {
            return;
          }

          var html = formatter.format(data);

          if (!html) {
            return;
          }

          if ($remove.length) {
            var existingHtml = $remove[0].outerHTML;
            $choice.html(existingHtml + html);
          } else {
            $choice.html(html);
          }
        });
      }

      function updateCarrierDropdown($element, formatter) {
        var $ = window.jQuery || window.$;

        if (typeof $ !== 'function' || !formatter || typeof formatter.format !== 'function' || !$element || typeof $element.data !== 'function') {
          return;
        }

        var instance = $element.data('select2');

        if (!instance || !instance.$dropdown) {
          return;
        }

        var $options = instance.$dropdown.find('.select2-results__option');

        $options.each(function () {
          var $option = $(this);
          var data = $option.data('data');

          if (!data) {
            return;
          }

          var html = formatter.format(data);

          if (html) {
            $option.html(html);
          }
        });
      }

      function addContainerThemeClass($element, attempt) {
        var currentAttempt = typeof attempt === 'number' ? attempt : 0;
        if (!$element || typeof $element !== 'object' || !$element.data) {
          return;
        }

        var instance = $element.data('select2');
        if (instance && instance.$container) {
          instance.$container.addClass('rj-select2-theme');
          return;
        }

        var maxThemeAttempts = 5;
        if (currentAttempt >= maxThemeAttempts) {
          return;
        }

        var schedule = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 50); };
        schedule(function () {
          addContainerThemeClass($element, currentAttempt + 1);
        });
      }

      function initValidationRuleSelect2(attempt) {
        var currentAttempt = typeof attempt === 'number' ? attempt : 0;
        var maxAttempts = 40;
        var retryDelay = 200;
        var $ = window.jQuery || window.$;

        var bootstrapSelect2 = function () {
          if (typeof $ !== 'function' || !$.fn || typeof $.fn.select2 !== 'function') {
            if (!select2InitRequested && window.prestashop && window.prestashop.component && typeof window.prestashop.component.initComponents === 'function') {
              select2InitRequested = true;
              window.prestashop.component.initComponents(['Select2']);
            }

            if (currentAttempt < maxAttempts) {
              setTimeout(function () {
                initValidationRuleSelect2(currentAttempt + 1);
              }, retryDelay);
            }
            return;
          }

          $('.js-validation-rule-select2').each(function () {
            var $element = $(this);
            var width = $element.data('width') || '100%';
            var placeholder = $element.data('placeholder') || '';
            var allowClear = String($element.data('allow-clear')) !== 'false';
            var isCarrierSelect = String($element.data('carrier-select')) === '1';

            if ($element.hasClass('select2-hidden-accessible')) {
              $element.select2('destroy');
            }

            var select2Config = {
              theme: 'bootstrap',
              width: width,
              placeholder: placeholder,
              allowClear: allowClear,
              closeOnSelect: false,
            };

            if (isCarrierSelect) {
              var carrierFormatter = buildCarrierTemplate($element);
              select2Config.escapeMarkup = function (markup) { return markup; };
              select2Config.templateResult = carrierFormatter.format;
              select2Config.templateSelection = carrierFormatter.format;
            }

            $element.select2(select2Config);
            addContainerThemeClass($element);

            $element.off('select2:open.rjTheme select2:close.rjTheme select2:closing.rjTheme select2:select.rjCarrier select2:unselect.rjCarrier');
            $element.on('select2:open.rjTheme', function () {
              addContainerThemeClass($element);
              addDropdownThemeClass();

              if (isCarrierSelect) {
                updateCarrierDropdown($element, carrierFormatter);
              }
            });
            $element.on('select2:close.rjTheme select2:closing.rjTheme', removeDropdownThemeClass);

            if (isCarrierSelect) {
              updateCarrierSelections($element, carrierFormatter);

              $element.on('select2:select.rjCarrier select2:unselect.rjCarrier', function () {
                updateCarrierSelections($element, carrierFormatter);
              });
            }
          });
        };

        bootstrapSelect2();
      }

      document.addEventListener('DOMContentLoaded', initValidationRuleSelect2);

      if (window.prestashop && typeof window.prestashop.on === 'function') {
        window.prestashop.on('formUpdated', initValidationRuleSelect2);
      }

      window.initValidationRuleSelect2 = initValidationRuleSelect2;
    }());
  </script>
{% endblock %}
