{% set orderId = record.id_order|default(0) %}
{% set infoId = record.id_info_shipment_raw|default(0) %}
<div class="btn-group" role="group">
  <button type="button"
          class="btn btn-outline-secondary btn-sm js-inline-save"
          data-order-id="{{ orderId }}"
          data-info-id="{{ infoId }}">
    {{ 'Guardar'|trans({}, 'Modules.RjMulticarrier.Admin') }}
  </button>
  <button type="button"
          class="btn btn-primary btn-sm js-inline-generate"
          data-order-id="{{ orderId }}"
          data-info-id="{{ infoId }}">
    {{ 'Generar envío'|trans({}, 'Modules.RjMulticarrier.Admin') }}
  </button>
</div>
